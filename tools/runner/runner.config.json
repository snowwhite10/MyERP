{
  "_comment": "MyERP AI Runner 設定。只可由人手修改。agents 按次序優先使用；某代理額度用完時自動改用下一個可用代理。",
  "agents": [
    {
      "name": "claude",
      "enabled": true,
      "command": "claude",
      "args": [
        "-p",
        "--dangerously-skip-permissions",
        "--output-format",
        "text"
      ],
      "quotaPatterns": [
        "usage limit",
        "hit your .{0,30}limit",
        "limit reached",
        "limit.{0,60}resets?\\b"
      ]
    },
    {
      "name": "codex",
      "enabled": true,
      "command": "codex",
      "args": [
        "exec",
        "--dangerously-bypass-approvals-and-sandbox",
        "-"
      ],
      "quotaPatterns": [
        "usage limit",
        "hit your .{0,30}limit",
        "limit reached",
        "quota exceeded",
        "insufficient_quota",
        "limit.{0,60}(resets?|try again)\\b",
        "429",
        "too many requests",
        "rate.?limit"
      ]
    }
  ],
  "roundTimeoutMinutes": 120,
  "pauseBetweenRoundsSeconds": 20,
  "resetBufferMinutes": 5,
  "unknownResetRetryMinutes": 30,
  "transientBackoffMinutes": [
    2,
    5,
    15,
    30
  ],
  "maxConsecutiveFailuresBeforeLongWait": 6,
  "longWaitMinutes": 60,
  "quotaScanTailLines": 25,
  "keepLastOutput": true
}