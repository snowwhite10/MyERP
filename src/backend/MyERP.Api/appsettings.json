{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "App": {
    "TimeZoneOffset": "+08:00",
    "SlowRequestMilliseconds": 1000,
    "Logging": {
      "FileEnabled": true,
      "FilePath": "logs/app-.log",
      "RetainedDays": 30
    }
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "Captcha": {
    "Length": 5,
    "ExpirySeconds": 120
  },
  "Security": {
    "Jwt": {
      "Issuer": "MyERP",
      "Audience": "MyERP",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 7
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "ForwardedHeaders": {
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    },
    "RateLimiting": {
      "Auth": { "PermitLimit": 5, "WindowSeconds": 60 },
      "Captcha": { "PermitLimit": 10, "WindowSeconds": 60 },
      "User": { "PermitLimit": 300, "WindowSeconds": 60 },
      "Export": { "PermitLimit": 10, "WindowSeconds": 60 }
    },
    "Hsts": {
      "MaxAgeDays": 365
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}
