{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "App": {
    "TimeZoneOffset": "+08:00",
    "SlowRequestMilliseconds": 1000,
    "Logging": {
      "FileEnabled": true,
      "FilePath": "logs/app-.log",
      "RetainedDays": 30
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}
