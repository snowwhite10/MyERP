{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "App": {
    "TimeZoneOffset": "+08:00",
    "SlowRequestMilliseconds": 1000,
    "Logging": {
      "FileEnabled": true,
      "FilePath": "logs/app-.log",
      "RetainedDays": 30
    }
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "Captcha": {
    "Length": 5,
    "ExpirySeconds": 120
  },
  "Security": {
    "Jwt": {
      "Issuer": "MyERP",
      "Audience": "MyERP",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 7
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}
